<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    
    <PropertyGroup>
        <ElsaVersion>3.6.0-rc5</ElsaVersion>
        <ElsaStudioVersion>3.6.0-rc5</ElsaStudioVersion>
        <ElsaExtensionsVersion>3.6.0-rc5</ElsaExtensionsVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" />
    </ItemGroup>
</Project>